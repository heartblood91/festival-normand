datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Department {
  CALVADOS
  EURE
  MANCHE
  ORNE
  SEINE_MARITIME
}

enum Category {
  ILLUMINATIONS
  EXPOSITIONS
  ANIMATIONS
  VISITES
}

model Event {
  id            String     @id @default(cuid())
  titleFr       String     @map("title_fr")
  titleEn       String?    @map("title_en")
  slug          String     @unique
  descriptionFr String     @map("description_fr") @db.Text
  descriptionEn String?    @map("description_en") @db.Text
  location      String
  city          String
  postalCode    String     @map("postal_code")
  department    Department
  category      Category
  dateStart     DateTime   @map("date_start")
  dateEnd       DateTime?  @map("date_end")
  timeStart     String?    @map("time_start")
  timeEnd       String?    @map("time_end")
  pricingFr     String?    @map("pricing_fr")
  pricingEn     String?    @map("pricing_en")
  organizer     String?
  email         String?
  phone         String?
  website       String?
  latitude      Float?
  longitude     Float?
  coverImage    String?    @map("cover_image")
  images        String[]   @default([])
  featured      Boolean    @default(false)
  accessible    Boolean    @default(false)
  published     Boolean    @default(false)
  publishedAt   DateTime?  @map("published_at")
  unpublishedAt DateTime?  @map("unpublished_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@map("events")
}

model News {
  id          String   @id @default(cuid())
  titleFr     String   @map("title_fr")
  titleEn     String?  @map("title_en")
  slug        String   @unique
  excerptFr   String?  @map("excerpt_fr")
  excerptEn   String?  @map("excerpt_en")
  contentFr   String   @map("content_fr") @db.Text
  contentEn   String?  @map("content_en") @db.Text
  coverImage  String?  @map("cover_image")
  published     Boolean  @default(false)
  publishedAt   DateTime? @map("published_at")
  unpublishedAt DateTime? @map("unpublished_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("news")
}

model Partner {
  id        String   @id @default(cuid())
  nameFr    String   @map("name_fr")
  nameEn    String?  @map("name_en")
  logo      String?
  website   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

model Page {
  id        String   @id @default(cuid())
  titleFr   String   @map("title_fr")
  titleEn   String?  @map("title_en")
  slug      String   @unique
  contentFr String   @map("content_fr") @db.Text
  contentEn String?  @map("content_en") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

enum Role {
  ADMIN
  EDITOR
}

// Better Auth tables
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role              Role      @default(EDITOR)
  twoFactorSecret   String?   @map("two_factor_secret")
  twoFactorBackupCodes String? @map("two_factor_backup_codes")
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]

  @@map("auth_users")
}

model TwoFactor {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  secret      String
  backupCodes String   @map("backup_codes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("auth_two_factors")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("auth_verifications")
}
