datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Department {
  CALVADOS
  EURE
  MANCHE
  ORNE
  SEINE_MARITIME
}

enum Category {
  ILLUMINATIONS
  EXPOSITIONS
  ANIMATIONS
  VISITES
}

model Event {
  id                     String                  @id @default(cuid())
  titleFr                String                  @map("title_fr")
  titleEn                String?                 @map("title_en")
  slug                   String                  @unique
  descriptionFr          String                  @map("description_fr") @db.Text
  descriptionEn          String?                 @map("description_en") @db.Text
  location               String
  city                   String
  postalCode             String                  @map("postal_code")
  department             Department
  category               Category
  dateStart              DateTime                @map("date_start")
  dateEnd                DateTime?               @map("date_end")
  timeStart              String?                 @map("time_start")
  timeEnd                String?                 @map("time_end")
  pricingFr              String?                 @map("pricing_fr")
  pricingEn              String?                 @map("pricing_en")
  organizer              String?
  email                  String?
  phone                  String?
  website                String?
  latitude               Float?
  longitude              Float?
  coverImage             String?                 @map("cover_image")
  /// Text alternative of the cover (RGAA); required to publish with a cover.
  coverImageAltFr        String?                 @map("cover_image_alt_fr")
  coverImageAltEn        String?                 @map("cover_image_alt_en")
  images                 String[]                @default([])
  /// Fondation du patrimoine collect for this site (public CTA and card badge).
  fundraisingUrl         String?                 @map("fundraising_url")
  fundraisingTitle       String?                 @map("fundraising_title")
  fundraisingImage       String?                 @map("fundraising_image")
  fundraisingSuggestions FundraisingSuggestion[]
  photos                 Photo[]
  themes                 Theme[]                 @relation("event_themes")
  tourinsoftId           String?                 @unique @map("tourinsoft_id")
  tourinsoftCategories   String?                 @map("tourinsoft_categories")
  tourinsoftUpdatedAt    DateTime?               @map("tourinsoft_updated_at")
  featured               Boolean                 @default(false)
  accessible             Boolean                 @default(false)
  published              Boolean                 @default(false)
  publishedAt            DateTime?               @map("published_at")
  unpublishedAt          DateTime?               @map("unpublished_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("events")
}

enum FundraisingSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Nearby Fondation collect proposed by scripts/match-collectes.ts; it reaches
/// the public site only once an editor attaches it to the event.
model FundraisingSuggestion {
  id               String                      @id @default(cuid())
  eventId          String                      @map("event_id")
  event            Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  projectCode      String                      @map("project_code")
  url              String
  title            String
  city             String
  imageUrl         String?                     @map("image_url")
  reason           String
  distanceKm       Float?                      @map("distance_km")
  collectedPercent Int?                        @map("collected_percent")
  status           FundraisingSuggestionStatus @default(PENDING)
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  @@unique([eventId, projectCode])
  @@index([status])
  @@map("fundraising_suggestions")
}

/// Editorial thread across events (e.g. Millennium): filter, home section, map marker.
model Theme {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameFr        String   @map("name_fr")
  nameEn        String?  @map("name_en")
  descriptionFr String?  @map("description_fr") @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  /// Hex colour of the theme chip and of map pins without a marker image.
  color         String   @default("#f59e0b")
  /// Map marker / emblem image, replaceable by upload in admin.
  markerImage   String?  @map("marker_image")
  showOnHome    Boolean  @default(false) @map("show_on_home")
  order         Int      @default(0)
  events        Event[]  @relation("event_themes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("themes")
}

/// Shared read-only travel book: only public event ids, no personal data.
model TravelBook {
  id        String   @id @default(uuid()) @db.Uuid
  /// sha256 of the sorted event ids: sharing the same selection reuses the row.
  key       String   @unique
  eventIds  String[] @map("event_ids")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("travel_books")
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  credit    String?
  title     String?
  order     Int      @default(0)
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@map("photos")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// One row per import run (Tourinsoft feed); powers health checks and the admin dashboard.
model SyncRun {
  id         String     @id @default(cuid())
  source     String
  trigger    String
  status     SyncStatus @default(RUNNING)
  startedAt  DateTime   @default(now()) @map("started_at")
  finishedAt DateTime?  @map("finished_at")
  total      Int        @default(0)
  created    Int        @default(0)
  updated    Int        @default(0)
  skipped    Int        @default(0)
  failed     Int        @default(0)
  error      String?

  @@index([source, startedAt])
  @@map("sync_runs")
}

model News {
  id              String    @id @default(cuid())
  titleFr         String    @map("title_fr")
  titleEn         String?   @map("title_en")
  slug            String    @unique
  excerptFr       String?   @map("excerpt_fr")
  excerptEn       String?   @map("excerpt_en")
  contentFr       String    @map("content_fr") @db.Text
  contentEn       String?   @map("content_en") @db.Text
  coverImage      String?   @map("cover_image")
  /// Text alternative of the cover (RGAA); required to publish with a cover.
  coverImageAltFr String?   @map("cover_image_alt_fr")
  coverImageAltEn String?   @map("cover_image_alt_en")
  published       Boolean   @default(false)
  publishedAt     DateTime? @map("published_at")
  unpublishedAt   DateTime? @map("unpublished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("news")
}

model Partner {
  id        String   @id @default(cuid())
  nameFr    String   @map("name_fr")
  nameEn    String?  @map("name_en")
  logo      String?
  website   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

model RegistrationLink {
  id         String     @id @default(cuid())
  department Department @unique
  url        String
  order      Int        @default(0)
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("registration_links")
}

// Per-department settings. `publishFrom` is the M1 embargo: upcoming
// Tourinsoft-imported events of the department stay hidden until that date.
model DepartmentSetting {
  department  Department @id
  publishFrom DateTime?  @map("publish_from")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("department_settings")
}

// Festival edition dates, edited in /admin/edition. The row with the highest
// year is the current edition; without any row the code default applies.
model Edition {
  year      Int       @id
  dateStart DateTime  @map("date_start") @db.Date
  dateEnd   DateTime  @map("date_end") @db.Date
  bilanFrom DateTime? @map("bilan_from") @db.Date
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("editions")
}

model Page {
  id        String   @id @default(cuid())
  titleFr   String   @map("title_fr")
  titleEn   String?  @map("title_en")
  slug      String   @unique
  contentFr String   @map("content_fr") @db.Text
  contentEn String?  @map("content_en") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

enum Role {
  ADMIN
  EDITOR
}

// Better Auth tables
model User {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  emailVerified        Boolean  @default(false) @map("email_verified")
  image                String?
  role                 Role     @default(EDITOR)
  twoFactorSecret      String?  @map("two_factor_secret")
  twoFactorBackupCodes String?  @map("two_factor_backup_codes")
  twoFactorEnabled     Boolean  @default(false) @map("two_factor_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  @@map("auth_users")
}

model TwoFactor {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  secret      String
  backupCodes String   @map("backup_codes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("auth_two_factors")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("auth_verifications")
}
