# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Resend (email service)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN="pk.xxxxxxxxxxxx"

# PostHog (optional analytics, enabled only when a public key is set)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Image storage, first configured wins: S3-compatible bucket (Garage, OVH…),
# then Vercel Blob, then local disk public/uploads (needs a persistent volume).
# The S3 bucket stays private: images are served by the app under /media/<key>.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxxxxxxxxx"

# Better Auth
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# Directus (for data migration)
DIRECTUS_URL="https://pierresenlumieres.fr/backend"
DIRECTUS_TOKEN="your-directus-token-here"

# Tourinsoft (event syndication import)
TOURINSOFT_SYNDICATION_URL="https://api-v3.tourinsoft.com/api/syndications/normandie.tourinsoft.com/<syndication-id>?format=json"

# Protected routes (cron + revalidation). Vercel Cron sends CRON_SECRET as a bearer.
CRON_SECRET="your-cron-secret-here"
REVALIDATE_TOKEN="your-revalidate-token-here"

# LLM (OpenRouter — FR→EN auto-translation of imported events, Gemini Flash)
OPENROUTER_API_KEY="sk-or-xxxxxxxxxxxx"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://pierresenlumieres.fr"

# PostHog read access for the admin stats page (personal API key, "query:read" scope only)
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""
POSTHOG_API_HOST="https://eu.posthog.com"

# Redis (optional): shares the public-form rate limits across instances and restarts.
# Without it, or while it is unreachable, limits are kept in memory.
REDIS_URL=""

# Cloudflare Turnstile (optional anti-spam on contact, review and survey forms).
# Active only when both keys are set; the site key is read at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
