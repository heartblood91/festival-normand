# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Resend (email service)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN="pk.xxxxxxxxxxxx"

# Vercel Blob (image storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxxxxxxxxx"

# Better Auth
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# Directus (for data migration)
DIRECTUS_URL="https://pierresenlumieres.fr/backend"
DIRECTUS_TOKEN="your-directus-token-here"

# Tourinsoft (event syndication import)
TOURINSOFT_SYNDICATION_URL="https://api-v3.tourinsoft.com/api/syndications/normandie.tourinsoft.com/<syndication-id>?format=json"

# Protected routes (cron + revalidation). Vercel Cron sends CRON_SECRET as a bearer.
CRON_SECRET="your-cron-secret-here"
REVALIDATE_TOKEN="your-revalidate-token-here"

# LLM (OpenRouter — FR→EN auto-translation of imported events, Gemini Flash)
OPENROUTER_API_KEY="sk-or-xxxxxxxxxxxx"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://pierresenlumieres.fr"
